# Copy to config/.env.l20.tree-prophetkv.chunk1024. Select via UCM_ENV_FILE.
# Read existing prepared inputs unchanged; derive only runtime boundaries.
PROJECT="/data/jh/unified-cache-management"
PYTHON_BIN="/data/jh/envs/ucm/bin/python"
MODEL_PATH="/data/jh/ckpts/Qwen3-32B"
EXPERIMENT_DIR="$PROJECT/outputs/ruler-l20-tp2-thinking-tree-prophetkv-chunk1024-500-v1"
PREPARED_DIR="$PROJECT/outputs/ruler-l20-tp2-thinking-tree-prophetkv-500-v1/prepared"
CACHE_ROOT="$PROJECT/.cache/ruler-l20-tp2-thinking-tree-prophetkv-chunk1024-500-v1"
TP="2"
SAMPLES_PER_TASK="500"
SEED="42"
PERCENTAGES="5 20 40 60"
# Five TP2 pairs in this order; BF16, automatic KV at 95%.
# Runtime reserves 1152 pinned transfer buffers/rank (9 GiB each; 90 GiB total).
# This chunk-1024 run uses a fresh CACHE_ROOT; never convert the old run in place.
GPU_DEVICES="GPU-9af1e932-db0c-d64a-e1d4-e86854f6168b,GPU-9487c377-cb87-c9cf-bdfd-7e9e0c5e93cf,GPU-568bf4a9-91fe-67c9-c454-c3f39345b17b,GPU-63808146-028b-5fb1-2e0c-0f4361156677,GPU-21292522-6b1d-d6fd-517d-4f5ad92c228f,GPU-c7cf4603-1994-5a84-cba8-a9005bc62dc9,GPU-1ef3727d-cbd0-0c94-eb49-7d58c12344d9,GPU-34e0b17f-40d7-6140-6f41-b92ab321b9f3,GPU-b8608e28-e8e5-0b2f-be5a-05bcd629d768,GPU-b155ae3b-2172-c9ff-8810-bed32cb1164d"

