# Paths and device UUIDs only. Hyperparameters are at the top of run.sh.
PYTHON_BIN=/absolute/path/to/environment/bin/python
# Original Qwen/Qwen3-32B snapshot: 9216db5781bf21249d130ec9da846c4624c16137
MODEL_PATH=/absolute/path/to/Qwen3-32B
RULER_PATH="$CODE_ROOT/data/RULER"
LONGBENCH_DATA="$CODE_ROOT/data/LongBench-v2/data.json"
RULER_PREPARED="$CODE_ROOT/data/prepared/ruler64k"
LONGBENCH_PREPARED="$CODE_ROOT/data/prepared/longbench-v2"
CACHE_ROOT="$CODE_ROOT/.cache/run"
RESULTS_DIR="$CODE_ROOT/results"
GPU_UUIDS=GPU-uuid-1,GPU-uuid-2,GPU-uuid-3,GPU-uuid-4
# Optional executable wrapper for the local driver environment.
PYTHON_WRAPPER=
