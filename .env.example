# Copy to .env in the checkout containing scripts/. Git ignores .env.
# One Bash KEY=VALUE assignment per line; quote paths containing spaces.
# Existing exported variables override this file, including values referenced
# by later assignments. No `export` commands are needed in your terminal.
# For a running experiment, use its EXISTING prepared/cache/output directories.

# L20 server (the actual checkout has no extra /ucm suffix).
PROJECT=/data/jh/unified-cache-management
PYTHON_BIN=/data/jh/envs/ucm/bin/python
MODEL_PATH=/data/jh/ckpts/Qwen3-32B
RULER_SOURCE="$PROJECT/.cache/vendor/RULER"
PREPARED_DIR="$PROJECT/.cache/ruler-64000-thinking-prepared"
CACHE_ROOT="$PROJECT/.cache/ruler-temporary"
# Replace this with the exact existing timestamped run directory.
EXPERIMENT_DIR="$PROJECT/outputs/REPLACE_WITH_EXISTING_L20_RUN_DIRECTORY"

# A800 alternative: replace the active L20 assignments above with these.
# PROJECT=/mnt/sde/jh/projects/unified-cache-management
# PYTHON_BIN=/mnt/sde/jh/envs/ucm/bin/python
# MODEL_PATH=/mnt/sde/jh/ckpts/Qwen3-32B
# LONGBENCH_DATA="$PROJECT/.data/LongBench-v2/data.json"
# PREPARED_DIR="$PROJECT/.data/LongBench-v2/prepared-qwen3-yarn4"
# CACHE_ROOT="$PROJECT/.cache/longbench-temporary"
# EXPERIMENT_DIR="$PROJECT/outputs/longbench-v2-503-yarn4-thinking16k"

# GPU_A and GPU_B are optional comma-separated lists of four GPU UUIDs.
# Defaults remain the original server-specific groups 0-3 and 4-7.
# A continuation must keep the original groups from group-*/plan.json.
# GPU_A=GPU-uuid0,GPU-uuid1,GPU-uuid2,GPU-uuid3
# GPU_B=GPU-uuid4,GPU-uuid5,GPU-uuid6,GPU-uuid7

# Optional server networking/cache settings:
# HTTPS_PROXY=http://your-proxy:port
# HTTP_PROXY=http://your-proxy:port
# HF_HOME=/your/huggingface/cache
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
